# Copy to .env and fill in. Do not commit .env.
# We use Vertex AI Gemini via Application Default Credentials (ADC).
# Run: gcloud auth application-default login

GOOGLE_CLOUD_PROJECT=synth-hackathon-2026
GOOGLE_CLOUD_LOCATION=us-central1

# Models
MEDGENT_MODEL_PRO=gemini-2.5-pro
MEDGENT_MODEL_FLASH=gemini-2.5-flash

# Agent caps
MEDGENT_MAX_ITERATIONS=60
MEDGENT_MAX_TOOL_CALLS_PER_FIELD=8
MEDGENT_MAX_TOTAL_TOOL_CALLS=200
